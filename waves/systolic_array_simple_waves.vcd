    $var wire 2 q write_pointers[1] [1:0] $end
    $var wire 2 r write_pointers[2] [1:0] $end
    $var wire 2 s write_pointers[3] [1:0] $end
    $var wire 2 Ev next_write_pointers[0] [1:0] $end
    $var wire 2 Fv next_write_pointers[1] [1:0] $end
    $var wire 2 Gv next_write_pointers[2] [1:0] $end
    $var wire 2 Hv next_write_pointers[3] [1:0] $end
    $var wire 32 t a [31:0] $end
    $var wire 32 "v i [31:0] $end
    $var wire 32 2w j [31:0] $end
    $var wire 32 u k [31:0] $end
    $var wire 2 3w full_check_wp [1:0] $end
   $upscope $end
  $upscope $end
 $upscope $end
$enddefinitions $end


